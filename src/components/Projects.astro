---
import projectsData from '../data/projects.json';
import { withBase } from '../lib/assetPath';
import { icons } from '../lib/icons';

const projects = projectsData as Array<(typeof projectsData)[number] & {
  repositories?: {
    label: string;
    i18nKey?: string;
    repo: string;
    url: string;
  }[];
}>;

function projectI18nKey(title: string) {
  if (title === 'Carved') return 'carved';
  if (title === 'SDL Arcade games') return 'sdl';
  if (title === 'Networked Games') return 'network';
  return '';
}
---

<section id="projects" class="projects-section">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 reveal visible">
      <p class="text-sm font-semibold tracking-widest text-highlight uppercase mb-3" data-i18n="projects.eyebrow">My work</p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold section-title" data-i18n="projects.title">Projects</h2>
    </div>

    <div class="projects-list">
      {
        projects.map((project, index) => {
          const hasImages = Boolean(project.backgroundImage && project.images?.length);
          const key = projectI18nKey(project.title);
          const ctaKey = project.repositories?.length
            ? 'projects.viewRepos'
            : project.link.includes('github.com')
              ? 'projects.viewGithub'
              : 'projects.playItch';
          const ctaLabel = project.repositories?.length
            ? 'View repositories'
            : project.link.includes('github.com')
              ? 'View on GitHub'
              : 'Play on itch.io';

          return (
            <article class={`project-feature reveal visible ${hasImages ? '' : 'project-feature--compact'}`}>
              <div class="project-art">
                {hasImages ? (
                  <>
                    <img
                      class="project-main-image"
                      src={withBase(project.backgroundImage)}
                      alt={`${project.title} screenshot`}
                      loading="lazy"
                      width="900"
                      height="560"
                    />
                    <div class="project-art-overlay" />
                    <div class="project-shots">
                      {project.images?.slice(0, 3).map((image, i) => (
                        <button
                          type="button"
                          class={`project-shot-button ${image === project.backgroundImage ? 'active' : ''}`}
                          data-gallery={String(index)}
                          data-image={withBase(image)}
                          aria-label={`Show ${project.title} screenshot ${i + 1}`}
                        >
                          <img src={withBase(image)} alt="" loading="lazy" width="160" height="90" />
                        </button>
                      ))}
                    </div>
                  </>
                ) : (
                  <div class="project-code-art" aria-hidden="true">
                    <div class="project-code-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" set:html={icons[project.icon] ?? icons['code-bracket-square']} />
                    </div>
                    {project.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
                  </div>
                )}
              </div>

              <div class="project-copy">
                <p class="project-eyebrow" data-i18n={key ? `projects.${key}.company` : undefined}>{project.company}</p>
                <h3>{project.title}</h3>
                <p class="project-description" data-i18n={key ? `projects.${key}.description` : undefined}>{project.description}</p>

                <div class="project-tags">
                  {project.tags.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>

                {project.repositories?.length ? (
                  <div class="repo-group" aria-label="Repository group" data-i18n-aria-label="projects.repoGroup">
                    {project.repositories.map((repo) => (
                      <a href={repo.url} target="_blank" rel="noopener" class="repo-link" aria-label={`Open repository ${repo.repo}`}>
                        <span class="repo-link-label" data-i18n={repo.i18nKey}>{repo.label}</span>
                        <span class="repo-link-name">{repo.repo.split('/')[1]}</span>
                      </a>
                    ))}
                  </div>
                ) : null}

                <a href={project.link} target="_blank" rel="noopener" class="project-link">
                  <span data-i18n={ctaKey}>{ctaLabel}</span>
                  <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path
                      d="M3 10h14M10 3l7 7-7 7"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  const shotButtons = document.querySelectorAll<HTMLButtonElement>('.project-shot-button');

  shotButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const nextImage = button.dataset.image;
      const projectCard = button.closest('.project-feature');
      const mainImage = projectCard?.querySelector<HTMLImageElement>('.project-main-image');
      if (!mainImage || !nextImage) return;

      mainImage.src = nextImage;
      projectCard.querySelectorAll('.project-shot-button').forEach((item) => item.classList.remove('active'));
      button.classList.add('active');
    });
  });
</script>

<style>
  .projects-section {
    padding: 6rem 0;
    background: rgba(15, 23, 42, 0.3);
    scroll-margin-top: 80px;
  }

  .projects-list {
    display: grid;
    gap: 1.4rem;
    max-width: 980px;
    margin: 0 auto;
  }

  .project-feature {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: 26rem;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(99, 102, 241, 0.22);
    border-radius: 1.25rem;
    background:
      radial-gradient(circle at 15% 15%, rgba(16, 185, 129, 0.16), transparent 34%),
      linear-gradient(135deg, rgba(15, 23, 42, 0.92), rgba(2, 6, 23, 0.82));
    box-shadow: 0 28px 80px rgba(2, 6, 23, 0.38);
  }

  .project-feature--compact {
    min-height: 22rem;
  }

  @media (min-width: 768px) {
    .project-feature {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }

  .project-art {
    position: relative;
    min-height: 17rem;
    overflow: hidden;
  }

  .project-code-art {
    position: relative;
    display: grid;
    place-content: center;
    gap: 0.75rem;
    min-height: 17rem;
    height: 100%;
    padding: 2rem;
    background:
      radial-gradient(circle at 32% 22%, rgba(56, 189, 248, 0.18), transparent 32%),
      radial-gradient(circle at 70% 72%, rgba(52, 211, 153, 0.14), transparent 34%),
      linear-gradient(135deg, rgba(15, 23, 42, 0.94), rgba(2, 6, 23, 0.78));
    color: #93c5fd;
  }

  .project-code-icon {
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    margin: 0 auto 0.5rem;
    border: 1px solid rgba(56, 189, 248, 0.24);
    border-radius: 1.1rem;
    background: rgba(15, 23, 42, 0.72);
  }

  .project-code-icon svg {
    width: 2.5rem;
    height: 2.5rem;
  }

  .project-code-art span {
    justify-self: center;
    border: 1px solid rgba(99, 102, 241, 0.22);
    border-radius: 999px;
    background: rgba(99, 102, 241, 0.08);
    color: #c4b5fd;
    padding: 0.35rem 0.8rem;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .project-art > img {
    width: 100%;
    height: 100%;
    min-height: 17rem;
    object-fit: cover;
    display: block;
    filter: saturate(1.15) brightness(0.72);
    transform: scale(1.04);
    transition:
      transform 0.5s ease,
      filter 0.5s ease;
  }

  .project-feature:hover .project-art > img {
    transform: scale(1.09);
    filter: saturate(1.3) brightness(0.82);
  }

  .project-art-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(2, 6, 23, 0.08), rgba(2, 6, 23, 0.72));
  }

  .project-shots {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
  }

  .project-shot-button {
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0.45rem;
    background: rgba(15, 23, 42, 0.78);
    cursor: pointer;
    transition:
      transform 0.22s ease,
      border-color 0.22s ease,
      box-shadow 0.22s ease;
  }

  .project-shot-button:hover,
  .project-shot-button.active {
    transform: translateY(-2px);
    border-color: rgba(52, 211, 153, 0.78);
    box-shadow: 0 10px 24px rgba(2, 6, 23, 0.34);
  }

  .project-shot-button:focus-visible {
    outline: 2px solid #34d399;
    outline-offset: 3px;
  }

  .project-shot-button img {
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 0;
    display: block;
    object-fit: cover;
    filter: saturate(1.1) brightness(0.9);
    transform: none;
  }

  .project-feature:hover .project-shot-button img {
    transform: none;
    filter: saturate(1.2) brightness(1);
  }

  .project-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem;
  }

  @media (min-width: 768px) {
    .project-copy {
      padding: 2.75rem;
    }
  }

  .project-eyebrow {
    margin: 0 0 0.7rem;
    color: #34d399;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .project-copy h3 {
    margin: 0;
    color: var(--text);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: 0;
  }

  .project-description {
    max-width: 34rem;
    margin: 1.2rem 0 0;
    color: var(--text-muted);
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.4rem;
  }

  .project-tags span {
    border: 1px solid rgba(52, 211, 153, 0.18);
    border-radius: 999px;
    background: rgba(16, 185, 129, 0.08);
    color: #a7f3d0;
    padding: 0.35rem 0.75rem;
    font-size: 0.74rem;
    font-weight: 700;
  }

  .repo-group {
    display: grid;
    gap: 0.55rem;
    margin-top: 1.35rem;
    padding: 0.8rem;
    border: 1px solid rgba(56, 189, 248, 0.16);
    border-radius: 0.75rem;
    background: rgba(15, 23, 42, 0.46);
  }

  .repo-link {
    display: grid;
    grid-template-columns: minmax(5.4rem, 0.36fr) minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    min-height: 2.55rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid rgba(148, 163, 184, 0.12);
    border-radius: 0.5rem;
    color: var(--text-muted);
    background: rgba(2, 6, 23, 0.38);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease;
  }

  .repo-link:hover {
    border-color: rgba(52, 211, 153, 0.42);
    background: rgba(16, 185, 129, 0.08);
    transform: translateX(3px);
  }

  .repo-link:focus-visible {
    outline: 2px solid #34d399;
    outline-offset: 3px;
  }

  .repo-link-label {
    color: #a7f3d0;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .repo-link-name {
    min-width: 0;
    overflow: hidden;
    color: #8fa8c8;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace;
    font-size: 0.72rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 460px) {
    .repo-link {
      grid-template-columns: 1fr;
      gap: 0.15rem;
      align-items: start;
    }
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.6rem;
    margin-top: 1.75rem;
    color: #020617;
    background: #34d399;
    border-radius: 999px;
    padding: 0.78rem 1.15rem;
    font-size: 0.9rem;
    font-weight: 900;
    text-decoration: none;
    transition:
      transform 0.22s ease,
      filter 0.22s ease,
      gap 0.22s ease;
  }

  .project-link:hover {
    gap: 0.85rem;
    filter: brightness(1.08);
    transform: translateY(-2px);
  }

  .project-link svg {
    width: 1rem;
    height: 1rem;
  }
</style>
