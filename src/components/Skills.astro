---
import skillsData from '../data/skills.json';
import { withBase } from '../lib/assetPath';
---

<section id="skills" class="py-24" style="scroll-margin-top: 80px;">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 reveal">
        <p class="text-sm font-semibold tracking-widest text-highlight uppercase mb-3" data-i18n="skills.eyebrow">
          What I work with
        </p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold section-title" data-i18n="skills.title">Tools & Skills</h2>
    </div>

    <div class="skills-shell max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8">
      {
        skillsData.map((category, ci) => (
          <div class="skills-card card reveal" style={`--category-index: ${ci}; transition-delay: ${ci * 0.1}s;`}>
            <div class="skills-card-header">
              <span class="skills-kicker">0{ci + 1}</span>
              <h3 data-i18n={`skills.${category.title.toLowerCase().replaceAll(' & ', '-').replaceAll(' ', '-')}`}>{category.title}</h3>
            </div>

            <div class="skill-grid">
              {category.skills.map((skill) => (
                <div class="skill-item">
                  <img
                    src={withBase(skill.logo)}
                    alt={skill.name}
                    class="skill-icon"
                    loading="lazy"
                    width="36"
                    height="36"
                  />
                  <span class="skill-name" data-i18n={skill.name === 'Gameplay Prototyping' ? 'skill.gameplay-prototyping' : skill.name === 'Level Design' ? 'skill.level-design' : undefined}>{skill.name}</span>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills-shell {
    perspective: 1200px;
  }

  .skills-card {
    position: relative;
    overflow: hidden;
    min-height: 10.5rem;
    border-color: color-mix(in srgb, var(--accent), transparent 76%);
    background:
      linear-gradient(135deg, rgba(99, 102, 241, 0.13), transparent 34%),
      linear-gradient(180deg, rgba(15, 23, 42, 0.88), rgba(2, 6, 23, 0.72));
    transition:
      transform 0.28s ease,
      border-color 0.28s ease,
      box-shadow 0.28s ease;
  }

  .skills-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 18% 0%, rgba(99, 102, 241, 0.26), transparent 32%),
      radial-gradient(circle at 88% 100%, rgba(14, 165, 233, 0.18), transparent 30%);
    opacity: 0;
    transition: opacity 0.28s ease;
    pointer-events: none;
  }

  .skills-card::after {
    content: '';
    position: absolute;
    inset: auto 1.5rem 0 1.5rem;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0.45;
    transform: scaleX(0.35);
    transition:
      opacity 0.28s ease,
      transform 0.28s ease;
  }

  .skills-card:hover {
    transform: translateY(-6px) rotateX(1deg);
    border-color: color-mix(in srgb, var(--accent), transparent 45%);
    box-shadow: 0 22px 55px rgba(2, 6, 23, 0.38);
  }

  .skills-card:hover::before {
    opacity: 1;
  }

  .skills-card:hover::after {
    opacity: 0.9;
    transform: scaleX(1);
  }

  .skills-card-header {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .skills-card-header h3 {
    margin: 0;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .skills-kicker {
    display: inline-grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border: 1px solid color-mix(in srgb, var(--accent), transparent 58%);
    border-radius: 999px;
    color: #c4b5fd;
    font-size: 0.68rem;
    font-weight: 800;
    background: rgba(15, 23, 42, 0.7);
  }

  .skill-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .skill-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-height: 6.2rem;
    padding: 0.75rem 0.45rem;
    border: 1px solid rgba(148, 163, 184, 0.12);
    border-radius: 0.8rem;
    background: rgba(15, 23, 42, 0.5);
    text-align: center;
    isolation: isolate;
    transition:
      transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1),
      border-color 0.24s ease,
      background 0.24s ease;
  }
  .skill-item:hover {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--accent), transparent 54%);
    background: rgba(30, 41, 59, 0.64);
  }

  .skill-item::after {
    content: '';
    position: absolute;
    top: 0.72rem;
    left: 50%;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    transform: translateX(-50%);
    background: conic-gradient(from 0deg, #38bdf8, #a78bfa, #22c55e, #38bdf8);
    filter: blur(12px);
    opacity: 0;
    z-index: -1;
    animation: skill-glow-spin 4s linear infinite;
    animation-play-state: paused;
    transition: opacity 0.12s ease;
  }
  .skill-item:hover::after {
    opacity: 0.12;
    animation-play-state: running;
    transition: opacity 0.75s ease;
  }

  @keyframes skill-glow-spin {
    from {
      transform: translateX(-50%) rotate(0deg);
    }
    to {
      transform: translateX(-50%) rotate(360deg);
    }
  }

  .skill-icon {
    position: relative;
    z-index: 1;
    width: 2.35rem;
    height: 2.35rem;
    object-fit: contain;
    filter: brightness(0.88) saturate(0.9);
    transition:
      filter 0.2s ease,
      transform 0.2s ease;
  }
  .skill-item:hover .skill-icon {
    filter: brightness(1.1) saturate(1.2);
    transform: scale(1.08);
  }

  .skill-name {
    position: relative;
    z-index: 1;
    font-size: 0.72rem;
    font-weight: 650;
    color: #7c8aa3;
    line-height: 1.2;
    transition:
      color 0.2s ease,
      text-shadow 0.2s ease;
  }
  .skill-item:hover .skill-name {
    color: #dbeafe;
    text-shadow: 0px 1px 1px black;
  }

  @media (max-width: 640px) {
    .skill-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .skills-card-header {
      align-items: flex-start;
    }
  }
</style>

<script>
  document.querySelectorAll('#skills .reveal').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.1 }
    );
    io.observe(el);
  });
</script>
