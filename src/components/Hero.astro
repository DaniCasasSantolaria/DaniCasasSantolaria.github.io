---
import personalData from '../data/personal.json';
import { getSocialLinks } from '../lib/socialLinks';
import { withBase } from '../lib/assetPath';
const socialLinks = getSocialLinks(personalData as unknown as Record<string, string | string[]>, personalData.heroSocialLinks);
---

<section id="home" class="editorial-hero">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="hero-topline"><span data-i18n="hero.eyebrow">Gameplay, with a human touch.</span><span>Barcelona · Portfolio</span></div>
    <div class="hero-layout">
      <div class="hero-intro">
        <div class="hero-identity">
          <img class="hero-portrait" src={withBase(personalData.photo)} alt={personalData.photoAlt} width="416" height="545" fetchpriority="high" />
        </div>
        <p class="hero-hello" data-i18n="hero.greeting">Hi, I'm</p>
        <h1>Daniel Casas<span>Santolaria<span class="name-period">.</span></span></h1>
        <p class="hero-role" data-i18n="hero.role">Gameplay Programmer & Game Developer</p>
        <p class="hero-description" data-i18n="hero.bio">{personalData.bio}</p>
        <div class="hero-actions">
          <a href="#projects" class="btn-primary"><span data-i18n="hero.primaryCta">View my projects</span><span aria-hidden="true">↗</span></a>
          <a href={withBase(personalData.cv)} target="_blank" rel="noopener noreferrer" class="hero-cv" data-i18n="hero.cv">Download CV</a>
        </div>
        <div class="hero-person">
          <div><div class="hero-socials">{socialLinks.map(link => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<span aria-hidden="true"> ↗</span></a>)}</div></div>
        </div>
      </div>
      <a class="hero-work" href="#projects" aria-label="Carved">
        <div class="work-caption"><span data-i18n="hero.featured">Selected project</span><span>01 / 03</span></div>
        <div class="work-image"><img src={withBase('/images/projects/carved/carved-3.png')} alt="Carved — 3D puzzle-platformer" width="900" height="900" fetchpriority="high" /><span class="work-stamp" aria-hidden="true">C<span>↗</span></span></div>
        <div class="work-info"><div><h2>Carved</h2><p data-i18n="hero.projectType">A world to explore. A puzzle to solve.</p></div><span class="work-arrow" aria-hidden="true">↗</span></div>
      </a>
    </div>
    <div class="hero-bottom"><span>Unity / Unreal Engine / C# / C++</span><a href="#projects"><span data-i18n="hero.scroll">Explore my work</span> ↓</a></div>
  </div>
</section>

<style>
  .editorial-hero { padding: 112px 0 0; }
  .hero-topline, .hero-bottom { display:flex; justify-content:space-between; gap:1rem; font-size:.7rem; letter-spacing:.1em; text-transform:uppercase; color:var(--text-muted); }
  .hero-topline, .hero-bottom, .work-caption { font-family:var(--font-mono); }
  .hero-topline { padding:0 0 24px; border-bottom:1px solid var(--border); }
  .hero-layout { display:grid; grid-template-columns:1.12fr 1fr; gap:5rem; align-items:center; padding:40px 0 48px; }
  .hero-hello { font-family:var(--font-mono); font-size:.9rem; font-style:normal; margin-bottom:12px; }
  h1 { font-family:var(--font-display); font-weight:700; font-size:clamp(2.8rem,4.6vw,4.7rem); line-height:1.03; letter-spacing:-.055em; }
  h1 > span { display:block; } .name-period { color:var(--accent); }
  .hero-role { font-size:.84rem; font-weight:600; margin-top:26px; color:var(--accent); }
  .hero-description { font-size:.95rem; line-height:1.85; max-width:27rem; margin-top:18px; color:var(--text-muted); }
  .hero-actions { display:flex; align-items:center; gap:28px; margin-top:30px; }
  .hero-actions .btn-primary { display:flex; gap:28px; align-items:center; }
  .hero-cv { font-size:.8rem; border-bottom:1px solid var(--text-dim); padding:8px 0; }
  .hero-person { display:flex; gap:14px; align-items:center; margin-top:24px; }
  .hero-identity { display:flex; align-items:center; gap:24px; margin-bottom:26px; }
  .hero-portrait { display:block; width:156px; height:188px; object-fit:cover; object-position:center 30%; border-radius:6px; border:1px solid var(--border); flex-shrink:0; }
  @media(max-width:767px) { .hero-portrait { width:132px; height:160px; } .hero-identity { gap:20px; margin-bottom:24px; } }
  .hero-socials { display:flex; gap:18px; font-size:.7rem; color:var(--text-muted); margin-top:6px; }
  .hero-work { display:block; transform:translateY(0); padding:18px; background:var(--bg-card-solid); border:1px solid var(--border); box-shadow:0 16px 40px #1018280a; border-radius:6px; transition:transform .3s; }
  .hero-work:hover { transform:translateY(-3px); }
  .work-caption { display:flex; justify-content:space-between; margin-bottom:14px; font-size:.65rem; text-transform:uppercase; letter-spacing:.13em; color:var(--text-muted); }
  .work-image { position:relative; aspect-ratio:1.15; overflow:hidden; background:#202329; }
  .work-image > img { width:100%; height:100%; object-fit:cover; }
  .work-stamp { position:absolute; bottom:16px; left:16px; font-family:var(--font-display); font-weight:700; font-size:2.5rem; color:#f1f3f7; }
  .work-stamp span { font-family:Arial,sans-serif; font-size:1rem; vertical-align:top; }
  .work-info { display:flex; justify-content:space-between; align-items:center; padding-top:18px; }
  .work-info h2 { font:650 2rem var(--font-display); letter-spacing:-.04em; } .work-info p { font-size:.7rem; color:var(--text-muted); margin-top:4px; }
  .work-arrow { font-size:1.5rem; } .hero-bottom { border-top:1px solid var(--border); padding:22px 0; }
  @media(max-width:1023px) { .hero-layout { gap:2.5rem; } }
  @media(max-width:767px) { .editorial-hero { padding-top:94px; } .hero-topline { font-size:.58rem; letter-spacing:.06em; } .hero-layout { grid-template-columns:1fr; gap:42px; padding:32px 0 40px; } h1 { font-size:clamp(2.25rem,9vw,4rem); } .hero-work { max-width:500px; margin:0 8px; } .hero-bottom { font-size:.56rem; letter-spacing:.03em; } .hero-actions { gap:20px; } .hero-person { margin-top:28px; } }
</style>
