---
import personalData from '../data/personal.json';
import menuData from '../data/menu.json';
import siteData from '../data/site.json';
import { getSocialLinks } from '../lib/socialLinks';

const currentYear = new Date().getFullYear();
const socialLinks = getSocialLinks(personalData as unknown as Record<string, string | string[]>);
const navLinks = menuData.sections.map((s) => ({ label: s.label, href: s.href }));
const footerKeywords = [
  'Gameplay Programming',
  'Game Systems',
  'Unity',
  'Unreal Engine',
  'C#',
  'C++',
  'Barcelona',
  'Video Game Development',
];
---

<footer id="site-footer" class="site-footer">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl py-14">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-mark" aria-hidden="true">
          <span>{siteData.shortName}</span>
        </div>

        <p class="footer-name">{personalData.name}</p>
        <p class="footer-tagline" data-i18n="footer.tagline">
          Gameplay programming | Interactive systems | Game development student
        </p>

        <a href={`mailto:${personalData.email}`} class="footer-email">
          <svg class="footer-email-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            />
          </svg>
          {personalData.email}
        </a>
      </div>

      <nav class="footer-nav" aria-label="Footer navigation" data-i18n-aria-label="footer.navigation">
        {
          navLinks.map((link) => (
            <a href={link.href} class="footer-nav-link" data-i18n={`nav.${link.href.slice(1)}.label`}>
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="footer-keywords" aria-label="Profile keywords" data-i18n-aria-label="footer.profileKeywords">
        {footerKeywords.map((kw, i) => <span class="footer-kw" data-i18n={`footer.keywords.${i}`}>{kw}</span>)}
      </div>
    </div>

    <div class="footer-divider"></div>

    <div class="footer-bottom">
      <p class="footer-copy">
        Copyright {currentYear} {personalData.name}
        <span aria-hidden="true">|</span>
        <a href={`mailto:${personalData.email}`}>{personalData.email}</a>
      </p>

      <div class="footer-socials">
        {
          socialLinks.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-social"
              aria-label={link.label}
            >
              <iconify-icon icon={link.icon} width="20" height="20" aria-hidden="true" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background:
      radial-gradient(circle at 18% 8%, rgba(99, 102, 241, 0.1), transparent 28%),
      rgba(2, 6, 23, 0.96);
    border-top: 1px solid rgba(99, 102, 241, 0.18);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 230px 150px minmax(0, 1fr);
      column-gap: 2.25rem;
      row-gap: 2.25rem;
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 240px 130px minmax(0, 1fr);
      column-gap: 2.75rem;
    }
  }

  .footer-mark {
    display: grid;
    place-items: center;
    width: 168px;
    aspect-ratio: 2 / 1;
    border: 2px solid rgba(99, 102, 241, 0.72);
    background:
      linear-gradient(135deg, rgba(15, 23, 42, 0.9), rgba(2, 6, 23, 0.66)),
      url('/images/projects/carved/carved-3.png') center / cover;
    box-shadow: 0 18px 42px rgba(2, 6, 23, 0.32);
  }

  .footer-mark span {
    color: #f8fafc;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 0.92;
    white-space: pre-line;
  }

  .footer-name {
    margin: 1.15rem 0 0;
    color: #60a5fa;
    font-size: 1.05rem;
    font-weight: 800;
  }

  .footer-tagline {
    max-width: 14rem;
    margin: 0.45rem 0 0;
    color: #64748b;
    font-size: 0.8rem;
    line-height: 1.7;
  }

  .footer-email {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.9rem;
    color: #94a3b8;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .footer-email:hover {
    color: #38bdf8;
    transform: translateY(-1px);
  }

  .footer-email-icon {
    width: 1rem;
    height: 1rem;
    opacity: 0.72;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    justify-self: start;
  }

  .footer-nav-link {
    color: #64748b;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-nav-link:hover {
    color: #a5b4fc;
  }

  .footer-keywords {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(112px, max-content));
    justify-content: start;
    align-content: start;
    gap: 0.5rem;
    width: 100%;
    max-width: 520px;
  }

  .footer-kw {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 1.75rem;
    border: 1px solid rgba(99, 102, 241, 0.16);
    border-radius: 999px;
    background: rgba(99, 102, 241, 0.05);
    color: #475569;
    padding: 0.22rem 0.65rem;
    font-size: 0.7rem;
    font-weight: 700;
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .footer-keywords {
      grid-template-columns: repeat(auto-fit, minmax(120px, max-content));
    }
  }

  .footer-divider {
    height: 1px;
    margin: 2.25rem 0;
    background: linear-gradient(90deg, transparent, rgba(14, 165, 233, 0.45), transparent);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
    }
  }

  .footer-copy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin: 0;
    color: #64748b;
    font-size: 0.9rem;
  }

  .footer-copy a {
    color: #94a3b8;
    font-weight: 700;
    text-decoration: none;
  }

  .footer-copy a:hover {
    color: #38bdf8;
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .footer-social {
    display: inline-flex;
    align-items: center;
    color: #475569;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .footer-social:hover {
    color: #a5b4fc;
    transform: translateY(-2px);
  }
</style>
