---
import '../styles/global.css';
import '../styles/editorial.css';
import siteData from '../data/site.json';
import personalData from '../data/personal.json';
import { withBase } from '../lib/assetPath';

interface Props {
  title?: string;
  description?: string;
}

// BASE_URL reflects astro.config.mjs `base` (set via BASE_PATH env var).
// Prepend it to every public/ asset path so the site works when deployed to a sub-directory.
const base = import.meta.env.BASE_URL;
const { title = siteData.title, description = siteData.description } = Astro.props;
const siteUrl = Astro.site ?? new URL(personalData.portfolioUrl);
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const shareImageUrl = new URL(withBase(personalData.photo), siteUrl).href;
---

<!doctype html>
<html lang="en" data-theme="light" data-theme-key={siteData.themeStorageKey}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={`${base}images/favicons/favicon.ico`} sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href={`${base}images/favicons/favicon-16x16.png`}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${base}images/favicons/favicon-32x32.png`}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href={`${base}images/favicons/favicon-96x96.png`}
    />
    <link
      rel="apple-touch-icon"
      sizes="57x57"
      href={`${base}images/favicons/apple-icon-57x57.png`}
    />
    <link
      rel="apple-touch-icon"
      sizes="60x60"
      href={`${base}images/favicons/apple-icon-60x60.png`}
    />
    <link
      rel="apple-touch-icon"
      sizes="72x72"
      href={`${base}images/favicons/apple-icon-72x72.png`}
    />
    <link
      rel="apple-touch-icon"
      sizes="76x76"
      href={`${base}images/favicons/apple-icon-76x76.png`}
    />
    <link
      rel="apple-touch-icon"
      sizes="114x114"
      href={`${base}images/favicons/apple-icon-114x114.png`}
    />
    <link
      rel="apple-touch-icon"
      sizes="120x120"
      href={`${base}images/favicons/apple-icon-120x120.png`}
    />
    <link
      rel="apple-touch-icon"
      sizes="144x144"
      href={`${base}images/favicons/apple-icon-144x144.png`}
    />
    <link
      rel="apple-touch-icon"
      sizes="152x152"
      href={`${base}images/favicons/apple-icon-152x152.png`}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={`${base}images/favicons/apple-icon-180x180.png`}
    />
    <link rel="manifest" href={`${base}manifest.json`} />
    <meta name="msapplication-config" content={`${base}browserconfig.xml`} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteData.ogSiteName} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:alt" content={personalData.photoAlt} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="416" />
    <meta property="og:image:height" content="545" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />
    <meta name="twitter:image:alt" content={personalData.photoAlt} />
    <meta name="theme-color" content="#17191e" id="meta-theme-color" />
    <link href={`${base}fonts/inter.css`} rel="stylesheet" />
    <script is:inline src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js" defer
    ></script>
    <title>{title}</title>
    <!-- Runs synchronously before first paint to apply the saved theme without a flash.
         is:inline prevents Astro from bundling or deferring this script. -->
    <script is:inline>
      (function () {
        try {
          var key = document.documentElement.dataset.themeKey || 'portfolio-theme';
          var t = localStorage.getItem(key);
          if (t !== 'dark') {
            document.documentElement.setAttribute('data-theme', 'light');
            var m = document.getElementById('meta-theme-color');
            if (m) m.setAttribute('content', '#f5f6f8');
          } else {
            document.documentElement.removeAttribute('data-theme');
            var m = document.getElementById('meta-theme-color');
            if (m) m.setAttribute('content', '#17191e');
          }
        } catch {}
      })();
    </script>
    <!-- Adds .page-hidden to <body> while the tab is not visible.
         Components can use this class to pause expensive animations. -->
    <script is:inline>
      document.addEventListener('visibilitychange', function () {
        document.body.classList.toggle('page-hidden', document.hidden);
      });
    </script>
    <script is:inline>
      (function () {
        var savedTheme = null;
        window.addEventListener('beforeprint', function () {
          try {
            var key = document.documentElement.dataset.themeKey || 'portfolio-theme';
            savedTheme = localStorage.getItem(key);
          } catch {}
          document.documentElement.removeAttribute('data-theme');
        });
        window.addEventListener('afterprint', function () {
          if (savedTheme !== 'dark') {
            document.documentElement.setAttribute('data-theme', 'light');
          }
          savedTheme = null;
        });
      })();
    </script>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"><span></span></div>
    <div class="cursor-aura" aria-hidden="true"></div>
    <a href="#main-content" class="skip-link" data-i18n="skip.main">Skip to main content</a>
    <slot />
    <script>
      const root = document.documentElement;
      const progress = document.querySelector('.scroll-progress span') as HTMLElement | null;
      const aura = document.querySelector('.cursor-aura') as HTMLElement | null;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      const updateProgress = () => {
        const scrollable = root.scrollHeight - root.clientHeight;
        const value = scrollable > 0 ? window.scrollY / scrollable : 0;
        progress?.style.setProperty('--scroll-progress', String(Math.min(1, Math.max(0, value))));
      };

      let pointerFrame = 0;
      window.addEventListener('pointermove', (event) => {
        if (!aura || reduceMotion.matches || event.pointerType === 'touch') return;
        cancelAnimationFrame(pointerFrame);
        pointerFrame = requestAnimationFrame(() => {
          aura.style.setProperty('--pointer-x', `${event.clientX}px`);
          aura.style.setProperty('--pointer-y', `${event.clientY}px`);
          aura.classList.add('is-visible');
        });
      }, { passive: true });

      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress, { passive: true });
      updateProgress();
    </script>
  </body>
</html>
